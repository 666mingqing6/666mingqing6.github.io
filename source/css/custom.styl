/* Iconfont 标准化 + 间距优化 + 视觉对齐 */
.iconfont {
  /* 1. 强制标准化容器，解决图标大小不一 */
  width: 1.2em;
  height: 1.2em;
  
  /* 2. 开启 Flex 布局让图标在容器内绝对居中 */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  
  /* 3. 恢复你喜欢的间距与对齐设置 */
  margin-right: 2px;       /* 图标与文字之间的固定间距 */
  vertical-align: -0.15em; /* 经过微调的对齐高度，比 middle 更精准 */
  
  /* 4. 样式微调 */
  font-size: 1.1em;
  line-height: 1;
  transition: all 0.3s ease;
  
  /* 5. 字体抗锯齿 */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 悬停效果 */
.iconfont:hover {
  transform: scale(1.1);
  opacity: 0.8;
}

::selection {
  background: #333; /* 选中文字背景变深灰 */
  color: #fff;      /* 选中文字变白 */
}

/* ---------------------------------
